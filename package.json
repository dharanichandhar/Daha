{
  "name": "daha-clothing-store",
  "version": "1.0.0",
  "private": true,
  "description": "DAHA Clothing Store - MERN E-Commerce Platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "start": "cd server && npm start",
    "seed:categories": "cd server && npm run seed:categories",
    "seed:admin": "cd server && npm run seed:admin",
    "seed:clear": "cd server && npm run seed:clear",
    "catalogue:clear-demo": "cd server && npm run catalogue:clear-demo"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
