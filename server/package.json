{
  "name": "daha-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "node -e \"const {execFileSync}=require('child_process');const cp=require('child_process');const fs=require('fs');const path=require('path');function walk(d){fs.readdirSync(d,{withFileTypes:true}).forEach(e=>{const p=path.join(d,e.name);if(e.isDirectory())walk(p);else if(p.endsWith('.js')){cp.execFileSync(process.execPath,['--check',p]);}})}walk('src');console.log('Server build OK: all sources parse');\"",
    "seed:categories": "node src/seeders/seedCategories.js",
    "seed:admin": "node src/seeders/seedAdmin.js",
    "seed:clear": "node src/seeders/clearSeed.js",
    "catalogue:clear-demo": "node src/seeders/clearDemoCatalog.js"
  },
  "dependencies": {
    "@react-router/express": "^7.18.3",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.11.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3",
    "slugify": "^1.6.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
